<% content_for :title, "Today's review" %>
<% content_for :main_class, "reading" %>

<header class="page-head">
  <h1>Review</h1>
  <p class="apparatus">
    <%= @review.scheduled_for.strftime("%a %-d %b") %> ·
    <%= pluralize(@review.highlights.size, "passage") %>
  </p>
</header>

<% if @review.highlights.any? %>
  <ol class="review-stack">
    <% @review.highlights.each_with_index do |highlight, index| %>
      <li class="review-entry" style="--i: <%= index %>">
        <%= passage highlight %>
        <p class="attribution">
          <%= link_to highlight.book.title, highlight.book %>
          <span class="author"><%= highlight.book.display_author %></span>
        </p>
        <% if highlight.note.present? %><p class="note"><%= highlight.note %></p><% end %>
        <%= provenance highlight %>
        <%= render "highlights/actions", highlight: highlight %>
        <%= render "highlights/editor", highlight: highlight %>
      </li>
    <% end %>
  </ol>
  <div class="review-finish">
    <%= button_to(@review.completed? ? "Reviewed today" : "Complete review", review_completion_path,
      class: "button", disabled: @review.completed?) %>
  </div>
<% else %>
  <div class="empty-state">
    <p class="eyebrow">Nothing to review</p>
    <h2>Import your Kindle highlights to start a daily review.</h2>
    <p>Holocron will set aside a fresh selection each morning.</p>
    <%= link_to "Import highlights", imports_path, class: "button" %>
  </div>
<% end %>
