<div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">
  <%= pluralize(@review.highlights.size, "passage") %> selected for you today.
</div>

<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; border-collapse: collapse; background-color: #e7e9e3;">
  <tr>
    <td align="center" style="padding: 32px 16px;">
      <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="width: 100%; max-width: 640px; border-collapse: collapse; background-color: #fbfcf9; border: 1px solid #ccd1c9;">
        <tr>
          <td style="padding: 36px 40px 28px; border-bottom: 1px solid #ccd1c9;">
            <p style="margin: 0 0 20px; color: #5c6360; font-family: 'Courier New', Courier, monospace; font-size: 11px; line-height: 1.4; letter-spacing: 2px; text-transform: uppercase;">Holocron</p>
            <h1 style="margin: 0 0 12px; color: #15181b; font-family: Georgia, 'Times New Roman', serif; font-size: 34px; font-weight: normal; line-height: 1.18;">Your daily review</h1>
            <p style="margin: 0; color: #5c6360; font-family: 'Courier New', Courier, monospace; font-size: 11px; line-height: 1.5; letter-spacing: 1px; text-transform: uppercase;">
              <%= @review.scheduled_for.strftime("%A, %-d %B") %>&nbsp;&nbsp;&middot;&nbsp;&nbsp;<%= pluralize(@review.highlights.size, "passage") %>
            </p>
          </td>
        </tr>

        <% @review.highlights.each_with_index do |highlight, index| %>
          <tr>
            <td style="padding: 34px 40px;<%= " border-bottom: 1px solid #ccd1c9;" if index < @review.highlights.size - 1 %>">
              <p style="margin: 0 0 20px; color: #15181b; font-family: Georgia, 'Times New Roman', serif; font-size: 21px; line-height: 1.55;">&ldquo;<%= highlight.text %>&rdquo;</p>
              <p style="margin: 0; color: #15181b; font-family: Georgia, 'Times New Roman', serif; font-size: 14px; line-height: 1.5;">
                <strong style="font-weight: bold;"><%= highlight.book.title %></strong><br>
                <span style="color: #5c6360;">by <%= highlight.book.display_author %></span>
              </p>
            </td>
          </tr>
        <% end %>

        <tr>
          <td style="padding: 32px 40px 38px; border-top: 1px solid #ccd1c9;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="border-collapse: collapse;">
              <tr>
                <td style="background-color: #15181b; border-radius: 3px;">
                  <%= link_to "Open today's review", review_url, style: "display: inline-block; padding: 13px 19px; color: #fbfcf9; font-family: 'Courier New', Courier, monospace; font-size: 11px; font-weight: bold; line-height: 1.2; letter-spacing: 1px; text-decoration: none; text-transform: uppercase;" %>
                </td>
              </tr>
            </table>
            <p style="margin: 18px 0 0; color: #5c6360; font-family: Georgia, 'Times New Roman', serif; font-size: 13px; line-height: 1.5;">Return to these passages, add notes, and complete today&rsquo;s review.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
