<section class="auth-card">
  <header class="auth-header">
    <div class="wordmark auth-wordmark"><span>H</span><strong>Holocron</strong></div>
    <p class="eyebrow">Welcome back</p>
    <h1>Return to your reading.</h1>
    <p>Your highlights, notes, and daily review are waiting.</p>
  </header>

  <%= form_with url: session_path, class: "auth-form" do |form| %>
    <label>Email address<%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "you@example.com", value: params[:email_address] %></label>
    <label>Password<%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Your password", maxlength: 72 %></label>
    <%= form.submit "Sign in", class: "button" %>
  <% end %>

  <%= link_to "Forgot your password?", new_password_path, class: "auth-link" %>
</section>
