<% content_for :title, @book.title %>
<% content_for :main_class, "reading" %>

<div class="book-head">
  <%= link_to "← Library", books_path, class: "back-link" %>
  <p class="author"><%= @book.display_author %></p>
  <h1><%= @book.title %></h1>
  <p class="apparatus muted"><%= pluralize(@book.highlights_count, "highlight") %></p>
</div>

<div class="reading-column">
  <% @highlights.each do |highlight| %>
    <article class="highlight highlight--catalog" id="highlight_<%= highlight.id %>">
      <%= passage highlight %>
      <% if highlight.note.present? %><p class="note"><%= highlight.note %></p><% end %>
      <%= provenance highlight %>
      <% if highlight.tag_list.any? %>
        <p class="provenance">
          <% highlight.tag_list.each do |tag| %><span class="tag">#<%= tag %></span><% end %>
        </p>
      <% end %>
      <%= render "highlights/actions", highlight: highlight %>
      <%= render "highlights/editor", highlight: highlight %>
    </article>
  <% end %>
</div>
<%= pagination %>
