<% content_for :title, "Library" %>

<header class="page-head">
  <h1>Library</h1>
  <div class="segmented">
    <%= link_to "A–Z", books_path, class: params[:sort].blank? ? "active" : nil %>
    <%= link_to "Recent", books_path(sort: "recent"), class: params[:sort] == "recent" ? "active" : nil %>
  </div>
</header>

<% if @books.any? %>
  <% busiest = @books.map(&:highlights_count).max %>
  <div class="shelf">
    <% @books.each do |book| %>
      <%= link_to book, class: "shelf-row" do %>
        <div class="shelf-row__cover">
          <% if book.cover_image_url.present? %>
            <%= image_tag book.cover_image_url, alt: "", loading: "lazy" %>
          <% else %>
            <span><%= book.title.first(2).upcase %></span>
          <% end %>
        </div>
        <div>
          <h2><%= book.title %></h2>
          <p class="author"><%= book.display_author %></p>
          <%= spectrum_bar book, relative_to: busiest %>
        </div>
        <span class="count"><%= book.highlights_count %></span>
      <% end %>
    <% end %>
  </div>
  <%= pagination %>
<% else %>
  <div class="empty-state">
    <p class="eyebrow">No books yet</p>
    <h2>Import your Kindle highlights and they'll be organized into books here.</h2>
    <p>Upload a clippings file, or connect your Amazon notebook to sync automatically.</p>
    <%= link_to "Import highlights", imports_path, class: "button" %>
  </div>
<% end %>
