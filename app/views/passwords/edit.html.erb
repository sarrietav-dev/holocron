<section class="auth-card">
  <header class="auth-header">
    <div class="wordmark auth-wordmark"><span>H</span><strong>Holocron</strong></div>
    <p class="eyebrow">Account recovery</p>
    <h1>Choose a new password.</h1>
    <p>Use a secure password you haven’t used elsewhere.</p>
  </header>

  <%= form_with url: password_path(params[:token]), method: :put, class: "auth-form" do |form| %>
    <label>New password<%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: "At least 8 characters", maxlength: 72 %></label>
    <label>Confirm password<%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: "Repeat your password", maxlength: 72 %></label>
    <%= form.submit "Update password", class: "button" %>
  <% end %>
</section>
