<% content_for :title, "Search" %>
<% content_for :main_class, "reading" %>

<header class="page-head">
  <h1>Search</h1>
  <p class="apparatus">
    <%= pluralize(@total_count, "passage") %><% if @query.present? %> matching <span class="verbatim">“<%= @query %>”</span><% end %>
  </p>
</header>

<%= form_with url: search_path, method: :get, class: "search-form" do |form| %>
  <%= form.search_field :q, value: @query, placeholder: "Search text, tag:wisdom, author:Austen…", autofocus: true, autocomplete: "off" %>
  <%= form.submit "Search", class: "button" %>
<% end %>

<% if @highlights.any? %>
  <div class="reading-column">
    <% @highlights.each do |highlight| %>
      <article class="highlight">
        <blockquote class="passage">
          <% if highlight.respond_to?(:search_excerpt) && highlight.search_excerpt.present? %>
            <p><%= sanitize highlight.search_excerpt, tags: %w[mark] %></p>
          <% else %>
            <%= simple_format highlight.text %>
          <% end %>
        </blockquote>
        <p class="attribution">
          <%= link_to highlight.book.title, highlight.book %>
          <span class="author"><%= highlight.book.display_author %></span>
        </p>
      </article>
    <% end %>
  </div>
  <%= pagination %>
<% elsif @query.present? %>
  <div class="empty-state">
    <p class="eyebrow">No matches</p>
    <h2>Try another word or phrase.</h2>
    <p>You can also narrow a search with filters such as <code>tag:wisdom</code> or <code>author:Austen</code>.</p>
  </div>
<% end %>
